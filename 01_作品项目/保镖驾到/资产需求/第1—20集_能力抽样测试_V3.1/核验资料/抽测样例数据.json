  "source_records": [
    {
      "id": "P064",
      "text": "▲绑匪基地，江辰脸上戴着半张银色面具，站在楼顶，冷冷地俯视着基地。",
      "episode": 1,
      "scene": "1-1"
    },
    {
      "id": "P066",
      "text": "老高（vo）：好，被绑架的人质叫苏小菲，她身上可能有西王母玉。",
      "episode": 1,
      "scene": "1-1"
    },
    {
      "id": "P074",
      "text": "▲不远处，苏小菲被绑在柱子上。因为被绳子勒紧，通过紧贴着的衣服，能看出她的姣好身材。",
      "episode": 1,
      "scene": "1-2"
    },
    {
      "id": "P091",
      "text": "绑匪首领（震惊）：银色面具，你……你是特工榜排名第一的孤狼！",
      "episode": 1,
      "scene": "1-2"
    },
    {
      "id": "P105",
      "text": "江辰（打量着苏小菲 os）这是西王母玉的治疗功效，果然在她身上！但她藏哪里了？",
      "episode": 1,
      "scene": "1-2"
    },
    {
      "id": "P115",
      "text": "▲江辰摘下面具，露出他英俊的脸庞。",
      "episode": 1,
      "scene": "1-2"
    },
    {
      "id": "P139",
      "text": "江辰：你好，我是保镖江辰。",
      "episode": 2,
      "scene": "2-1"
    },
    {
      "id": "P203",
      "text": "▲苏小菲偷偷观察江辰，江辰的侧脸棱角分明，她心跳有些加快，脸色微红。",
      "episode": 3,
      "scene": "3-1"
    },
    {
      "id": "P317",
      "text": "6-2 夜 内 苏家别墅",
      "episode": 6,
      "scene": "6-2"
    },
    {
      "id": "P322",
      "text": "▲苏小菲说完，上了楼。",
      "episode": 6,
      "scene": "6-2"
    },
    {
      "id": "P329",
      "text": "6-3 夜 外 苏家别墅院子",
      "episode": 6,
      "scene": "6-3"
    },
    {
      "id": "P331",
      "text": "▲苏家别墅的围墙上，打手们接二连三翻落，跳进院子里，迅速前进。",
      "episode": 6,
      "scene": "6-3"
    },
    {
      "id": "P336",
      "text": "▲“砰！砰！砰！”闷响声此起彼伏，打手如断线风筝般倒飞出去，有的摔进花坛，有的跌进水池，有的滚落台阶。",
      "episode": 6,
      "scene": "6-3"
    },
    {
      "id": "P344",
      "text": "7-1 夜 外 苏小菲卧室和阳台",
      "episode": 7,
      "scene": "7-1"
    },
    {
      "id": "P346",
      "text": "▲卧室内，苏小菲穿着睡衣，伸了个懒腰，刚掀开被子，忽然听到院子里有声音。",
      "episode": 7,
      "scene": "7-1"
    },
    {
      "id": "P348",
      "text": "▲她起身走出阳台，看到院子里，打手头领正拿着匕首，刺向江辰，苏小菲震惊地瞪大眼。",
      "episode": 7,
      "scene": "7-1"
    },
    {
      "id": "P357",
      "text": "▲苏小菲飞快跑到院子里，看到院子里横七竖八躺着一堆人。",
      "episode": 7,
      "scene": "7-2"
    },
    {
      "id": "P370",
      "text": "7-3 夜 内 苏小菲卧室",
      "episode": 7,
      "scene": "7-3"
    },
    {
      "id": "P372",
      "text": "▲江辰抱着苏小菲回到卧房，把她放在床上。",
      "episode": 7,
      "scene": "7-3"
    },
    {
      "id": "P374",
      "text": "▲江辰走到窗边，打通一个电话。",
      "episode": 7,
      "scene": "7-3"
    },
    {
      "id": "P375",
      "text": "江辰：老高，我这里出了点状况，你找人过来打扫一下。",
      "episode": 7,
      "scene": "7-3"
    },
    {
      "id": "P378",
      "text": "▲江辰的目光扫过苏小菲娇美的脸庞，最终落在她胸前睡衣的扣子上。",
      "episode": 7,
      "scene": "7-3"
    },
    {
      "id": "P388",
      "text": "8-2 日 内 苏小菲卧室",
      "episode": 8,
      "scene": "8-2"
    },
    {
      "id": "P392",
      "text": "▲她掀开被子起床，连睡衣都没换，冲出房间。",
      "episode": 8,
      "scene": "8-2"
    },
    {
      "id": "P397",
      "text": "▲身穿睡衣的苏小菲冲下楼。",
      "episode": 8,
      "scene": "8-3"
    },
    {
      "id": "P407",
      "text": "▲苏小菲跑到院子里，看到整洁的院子，她满脸的不可思议。",
      "episode": 8,
      "scene": "8-3"
    },
    {
      "id": "P408",
      "text": "苏小菲（喃喃）：一点打斗的痕迹都没有，难道真的是我在做梦……（回头看向江辰，突然大声）不对，我记得昨晚你还打晕了我，你打我的时候，好痛！",
      "episode": 8,
      "scene": "8-3"
    },
    {
      "id": "P422",
      "text": "▲院中悄无声息进来一个黑衣人（字幕：血手，杀手榜第八），身形如鬼魅般飘到张阎王身前。",
      "episode": 9,
      "scene": "9-1"
    },
    {
      "id": "P425",
      "text": "▲血手几个闪现，所有人都摔倒在地，特写血手举在半空，戴着血色手套的右手。",
      "episode": 9,
      "scene": "9-1"
    },
    {
      "id": "P427",
      "text": "血手（冷酷）：我是血手，上面派我来帮你。（扫了眼地上的打手，嗤笑）果然是一群废物，难怪连个人都抓不到。",
      "episode": 9,
      "scene": "9-1"
    },
    {
      "id": "P445",
      "text": "▲不远处，一位高挑靓丽的白人女孩，微笑着朝苏小菲走来。",
      "episode": 9,
      "scene": "9-2"
    },
    {
      "id": "P446",
      "text": "▲字幕：雪狐（艾薇）特工榜第十",
      "episode": 9,
      "scene": "9-2"
    },
    {
      "id": "P488",
      "text": "▲血手闪现来到苏小菲面前，血红手套的右手抓向苏小菲。",
      "episode": 10,
      "scene": "10-2"
    },
    {
      "id": "P490",
      "text": "▲血手转手攻向艾薇，艾薇被击退三步。血手追击，艾薇胸口被血手击中，当场倒在地上。",
      "episode": 10,
      "scene": "10-2"
    },
    {
      "id": "P511",
      "text": "血手（略带不屑）：速度是挺快，看着也唬人。可惜了，我认识你，你是“影”，特工榜排名四十九的吊车尾。",
      "episode": 11,
      "scene": "11-1"
    },
    {
      "id": "P549",
      "text": "▲重伤的艾薇忍不住呻吟出声，吐出一口黑血。苏小菲脸色剧变，扑到艾薇身边跪下来。",
      "episode": 12,
      "scene": "12-1"
    },
    {
      "id": "P551",
      "text": "艾薇（脸色苍白，嘴角带血）：当年……我执行任务受伤，是你救了我一命。现在，保护你是我应该做的事。",
      "episode": 12,
      "scene": "12-1"
    },
    {
      "id": "P552",
      "text": "▲艾薇话音刚落，又接连咳血。",
      "episode": 12,
      "scene": "12-1"
    },
    {
      "id": "P555",
      "text": "▲苏小菲双手放在艾薇的胸口。一道隐约可见的绿色光芒从苏小菲右手掌心散发出来，没入艾薇的胸口。",
      "episode": 12,
      "scene": "12-1"
    },
    {
      "id": "P556",
      "text": "▲艾薇的脸色，肉眼可见好转。",
      "episode": 12,
      "scene": "12-1"
    },
    {
      "id": "P558",
      "text": "江辰（os）：这是……西王母玉的力量。",
      "episode": 12,
      "scene": "12-1"
    },
    {
      "id": "P579",
      "text": "▲苏小菲治疗结束，搀扶着艾薇站起来。",
      "episode": 13,
      "scene": "13-1"
    },
    {
      "id": "P587",
      "text": "艾薇：小菲的能力非常神奇，我没事了。",
      "episode": 13,
      "scene": "13-1"
    },
    {
      "id": "P629",
      "text": "▲江辰掏出一个手掌大小的微型计算机，用数据线连接微型计算机和张阎王的手机，然后在微型计算机的屏幕上点了几下。",
      "episode": 14,
      "scene": "14-1"
    },
    {
      "id": "P630",
      "text": "▲微型计算机屏幕跳出一段IP地址。",
      "episode": 14,
      "scene": "14-1"
    },
    {
      "id": "P676",
      "text": "▲苏小菲推门进去，看到江辰脱了上衣，正准备走向卫生间，二人四目相对。",
      "episode": 16,
      "scene": "16-1"
    },
    {
      "id": "P782",
      "text": "▲周天掏出一副钢铁拳套，戴上。苏小菲脸色大变。",
      "episode": 19,
      "scene": "19-1"
    },
    {
      "id": "P788",
      "text": "▲江辰目光落在苏小菲耳朵上的耳环上。",
      "episode": 19,
      "scene": "19-1"
    },
    {
      "id": "P790",
      "text": "▲江辰伸手，摘下苏小菲一只耳环。手指不经意磨摩擦耳垂，苏小菲脸红了。",
      "episode": 19,
      "scene": "19-1"
    },
    {
      "id": "P800",
      "text": "▲周天拳头朝着江辰打来，江辰淡定地站在原地，右手食指和中指捏着耳环，迎向周天的拳套。",
      "episode": 20,
      "scene": "20-1"
    },
    {
      "id": "P801",
      "text": "▲耳环正中拳套，周天发出一声惨叫，狼狈地倒退几步。",
      "episode": 20,
      "scene": "20-1"
    },
    {
      "id": "P803",
      "text": "▲周天惊慌失措地查看拳套，拳套逐渐破裂（做裂纹特写），他大惊失色。",
      "episode": 20,
      "scene": "20-1"
    },
    {
      "id": "P804",
      "text": "▲江辰晃了晃指间的耳环，完好无损。",
      "episode": 20,
      "scene": "20-1"
    },
    {
      "id": "P808",
      "text": "江辰（勾起嘴角）：影，特工榜四十九。",
      "episode": 20,
      "scene": "20-1"
    },
    {
      "id": "P817",
      "text": "江辰（微笑，递上耳环）：耳环还给你。",
      "episode": 20,
      "scene": "20-1"
    },
    {
      "id": "P821",
      "text": "▲江辰靠近苏小菲，帮她戴耳环。",
      "episode": 20,
      "scene": "20-1"
    },
    {
      "id": "P825",
      "text": "▲江辰为她戴好耳环，轻拍她的肩膀。",
      "episode": 20,
      "scene": "20-1"
    }
  ],
