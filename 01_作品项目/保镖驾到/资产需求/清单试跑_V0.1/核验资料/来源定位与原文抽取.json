        "P13手机屏幕、P14微型计算机与数据线"
      ]
    },
    {
      "id": "T10R007",
      "cells": [
        "第16—22集 校园/食堂",
        "校园广场、食堂陈设",
        "P06耳环、P07拳套，玫瑰花束作为临时道具"
      ]
    },
    {
      "id": "T10R008",
      "cells": [
        "第23—28集 废弃工厂/野外",
        "厂房、废料堆、野外树木",
        "P02面具、弩箭、石子动作和治疗特效"
      ]
    },
    {
      "id": "T10R009",
      "cells": [
