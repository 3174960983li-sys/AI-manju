    {
      "id": "P001",
      "text": "《保镖驾到，大小姐爱上了我》"
    },
    {
      "id": "P002",
      "text": "全60集｜场景与道具精简整合清单"
    },
    {
      "id": "P003",
      "text": "生产用途：真人短剧资产设定、生图分工、分镜对接、跨集一致性检查"
    },
    {
      "id": "P004",
      "text": "依据：版本一全60集剧本（96个分场、34种原始场景标题）；制作分类为建议方案，不改变原剧本剧情与地点。"
    },
    {
      "id": "P005",
      "text": "01｜总览与判定原则"
    },
    {
      "id": "P006",
      "text": "核心目标：将可由场景直接生成的陈设剔出独立道具清单，合并同一地点的场景名称，同时保留剧情反转、道具特写、空间连贯和特效所需的独立资产。"
    },
    {
      "id": "T1R001",
      "cells": [
        "资产层级",
        "生产方式",
        "必须保留的约束"
      ]
    },
    {
      "id": "T1R002",
      "cells": [
        "A｜完整母场景（7组）",
        "建立空间基准、主机位、反打与关键子场景",
        "高频反复出现、多角色走位、复杂战斗、完整建筑关系"
      ]
    },
    {
      "id": "T1R003",
      "cells": [
        "B｜轻量母场景（7组）",
        "主视角＋必要局部或反打",
        "低频或单一叙事区，按分镜加角度"
      ]
    },
    {
      "id": "T1R004",
      "cells": [
        "C｜临时背景（2类）",
        "与车辆或分镜一起生成",
        "跨镜头仍需保持方向与外观统一"
      ]
    },
    {
      "id": "T1R005",
      "cells": [
        "道具A｜场景自带",
        "与场景一次性生成，不单独设定图",
        "固定位置与形状，避免镜头间变动"
      ]
    },
    {
      "id": "T1R006",
      "cells": [
        "道具B｜镜头临时",
        "随人物动作生成，必要时做小范围参考",
        "短期连续性，如从拿起到放下"
      ]
    },
    {
      "id": "T1R007",
      "cells": [
        "道具C｜独立核心",
        "单独设定图＋状态图＋特效约束",
