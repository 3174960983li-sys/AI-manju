    {
      "id": "P026",
      "text": "06｜特效、动物与载具：另行管理"
    },
    {
      "id": "T9R001",
      "cells": [
        "类别",
        "应建立的资产",
        "不能与普通道具混淆的理由"
      ]
    },
    {
      "id": "T9R002",
      "cells": [
        "人物特效",
        "高速闪现、拳脚冲击、伤口自愈、绿色治疗、金银能量、黑气、悬浮飞刀、残魂消散",
        "跟人物状态和剧情阶段绑定；不是实体道具。"
      ]
    },
    {
      "id": "T9R003",
      "cells": [
        "动物角色",
        "藏獒“大将军”",
        "独立角色资产：趴卧、龇牙、扑出、服从、摇尾等动作。"
      ]
    },
    {
      "id": "T9R004",
      "cells": [
        "载具",
        "直升机、保姆车、豪车",
        "归为交通资产，必要时统一车内/车外/上下车空间。"
      ]
    },
    {
      "id": "T9R005",
      "cells": [
        "群演与组织",
        "绑匪、打手、杀手、特工、战神卫、地下势力等",
        "属于人物/群演资产，不计入场景或道具数量。"
      ]
    },
    {
      "id": "P027",
      "text": ""
    },
    {
      "id": "P028",
      "text": "07｜场景 × 道具的制作对应关系"
    },
    {
      "id": "T10R001",
      "cells": [
