    {
      "id": "P004",
      "text": "阿宁，28岁，诊所医师。性格沉着、谨慎，黑色短发。村民称她宁姐。",
      "episode": 1,
      "scene": "1-1"
    },
    {
      "id": "P005",
      "text": "▲阿宁穿灰色日常外套站在靠窗木桌旁，门旁是药柜。",
      "episode": 1,
      "scene": "1-1"
    },
    {
      "id": "P006",
      "text": "第二集",
      "episode": 2,
