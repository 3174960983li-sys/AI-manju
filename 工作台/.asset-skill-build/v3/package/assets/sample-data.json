      "id": "P007",
      "text": "2-1 夜 内 东村诊所",
      "episode": 2,
      "scene": "2-1"
    },
    {
      "id": "P008",
      "text": "▲阿宁换上白色工作服，右袖被雨打湿，右前臂出现一道划伤。",
      "episode": 2,
      "scene": "2-1"
    },
    {
      "id": "P009",
      "text": "第三集",
      "episode": 3,
